<Page
    x:Class="Aoe4OverlayWinUI3.Views.GamesListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Aoe4OverlayWinUI3.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helper:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helper:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <!--  自定义导航栏头部模板：标题左侧 + 刷新按钮右侧（在代码隐藏中设置）  -->
        <DataTemplate x:Key="GamesListHeaderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="{Binding}" />
                    <!--
                        刷新频率说明按钮：点击弹出 Flyout，解释手动/自动刷新频率限制及原因
                    -->
                    <Button
                        x:Uid="GamesList_RefreshInfoButton"
                        Margin="0,0,4,0"
                        Padding="4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Refresh rate info"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Refresh rate info">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE946;" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <TextBlock
                                    x:Uid="GamesList_RefreshInfo_Text"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <!--  用单独 Grid 包裹按钮，加上与内容区相同的边距，使按钮右侧与 DataGrid 平齐  -->
                <Grid Grid.Column="1" Margin="0,0,56,0">
                    <!--
                        刷新按钮：未绑定账户（HasSavedProfile=false）时禁用，
                        避免用户对着空数据页发起无意义的刷新请求；
                        FallbackValue 设为 False，防止模板在页面就绪前短暂可点
                    -->
                    <Button
                        x:Uid="GamesList_RefreshButton"
                        Margin="0,0,0,0"
                        Padding="10,6,10,6"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Refresh"
                        AutomationProperties.Name="Refresh"
                        Command="{Binding Content.ViewModel.RefreshCommand, ElementName=NavigationFrame, FallbackValue={x:Null}}"
                        IsEnabled="{Binding Content.ViewModel.HasSavedProfile, ElementName=NavigationFrame, FallbackValue=False}">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--  TODO: 将对战列表页更改为 ListView 代替 DataGrid  -->

    <Grid x:Name="ContentArea">
        <controls:DataGrid
            AutoGenerateColumns="False"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasSavedProfile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:DataGrid.Resources>
                <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundColor" Color="Transparent" />
            </controls:DataGrid.Resources>
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn x:Uid="GamesList_ResultColumn" Binding="{Binding Result}" />
                <controls:DataGridTextColumn x:Uid="GamesList_MapColumn" Binding="{Binding Map}" />
                <controls:DataGridTextColumn x:Uid="GamesList_CivilizationColumn" Binding="{Binding Civilization}" />
                <controls:DataGridTextColumn x:Uid="GamesList_DurationColumn" Binding="{Binding Duration}" />
                <controls:DataGridTextColumn x:Uid="GamesList_StartTimeColumn" Binding="{Binding StartTime}" />
                <controls:DataGridTextColumn x:Uid="GamesList_KindColumn" Binding="{Binding Kind}" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <ProgressRing
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!--  未绑定账户时的空状态提示，用户可通过左侧导航栏进入设置绑定账户  -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasSavedProfile, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="36"
                Glyph="&#xE77B;"
                Opacity="0.6" />
            <TextBlock
                x:Uid="GamesList_NoAccount_Title"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="GamesList_NoAccount_Description"
                HorizontalAlignment="Center"
                Opacity="0.6"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
